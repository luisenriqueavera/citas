# ================================================================
# FCV TRAINING LAB · Proyecto de citas
# Copia este archivo a .env. NO subas .env a Git.
# ================================================================
COMPOSE_PROJECT_NAME=fcv-citas-training

MYSQL_DATABASE=citas_fcv_training
MYSQL_USER=citas_app
MYSQL_PASSWORD=CitasApp_2026!
MYSQL_ROOT_PASSWORD=RootCitas_2026!
MYSQL_PORT=3307

API_PORT=8080
REACT_PORT=5173
ANGULAR_PORT=4200

# Valores que usará el backend cuando sea implementado por el estudiante.
DB_HOST=mysql
DB_PORT=3307
DB_NAME=citas_fcv_training
DB_USER=citas_app
DB_PASSWORD=CitasApp_2026!

# Secretos de JWT de LABORATORIO. Sustituir en cada repo personal.
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# URL pública usada por el frontend cuando corra en el host.
VITE_API_URL=http://localhost:8080

# Opcional: URL del webhook n8n para notificaciones de cambio de estado (S5/S6, WF-002).
# Vacío = notificador deshabilitado (no-op).
APPOINTMENT_WEBHOOK_URL=
# Recomendado junto con APPOINTMENT_WEBHOOK_URL: secreto compartido enviado como header
# X-Webhook-Secret. Debe coincidir con la credencial Header Auth del nodo Webhook en WF-002.
APPOINTMENT_WEBHOOK_SECRET=
